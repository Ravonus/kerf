import type { State } from 'weft'
import type { Stock } from '../api'
import { money, pct, sparkline } from '../lib/format'

export function StockRow({ stock, prices, histories }: { stock: Stock; prices: State<Record<string, number>>; histories: State<Record<string, number[]>> }) {
  return (
    <li>
      <span data-testid="symbol">{stock.symbol}</span>
      <span data-testid="name">{stock.name}</span>
      <span data-testid="price">{money(prices.get(stock.id).value ?? stock.price)}</span>
      <span data-testid="change">{pct((((prices.get(stock.id).value ?? stock.price) - stock.prevClose) / stock.prevClose) * 100)}</span>
      <svg data-testid="spark" width="60" height="16"><path d={sparkline(histories.get(stock.id).value ?? [stock.price])} /></svg>
    </li>
  )
}
