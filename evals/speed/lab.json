{
 "flags": [
  {
   "name": "REUSE",
   "says": "A re-run keeps the links of the sources it reads again, in order."
  },
  {
   "name": "LITERAL",
   "says": "Graph lists of one or two are written as literals."
  },
  {
   "name": "MICRO",
   "says": "A manual `flush` leaves a queued microtask in place rather than queueing another."
  },
  {
   "name": "POP",
   "says": "Unlinking from the end of a list pops, and a full unlink doesn't touch the old list."
  },
  {
   "name": "OWNKEYS",
   "says": "Keyed writes compare the object's keys when there are far more readers than keys."
  },
  {
   "name": "ENDS",
   "says": "`For` finds rows that stayed at either end by position, with no Map."
  },
  {
   "name": "SWAP",
   "says": "Two rows or nodes that traded places cost two moves, and no longest-run search."
  },
  {
   "name": "ROWBOX",
   "says": "A row is its item's box, not a row and a box."
  },
  {
   "name": "DEFER",
   "says": "Rows are checked for repeated keys when a later pass could keep them, not as they're made."
  },
  {
   "name": "FLAT",
   "says": "Rows of one element reach `place` as they are, not through `resolve`."
  },
  {
   "name": "TEXT",
   "says": "A hole that's its parent's only child writes `textContent`."
  },
  {
   "name": "WIPE",
   "says": "Emptying a parent the hole fills is one `textContent` write."
  },
  {
   "name": "SCAN",
   "says": "A pass that moves nothing already placed doesn't look for what was."
  },
  {
   "name": "LINEAR",
   "says": "Up to 8 rows between the ends are matched by scanning, with no Map to build."
  }
 ],
