# Copy to .env. Mail stays skipped while SMTP_HOST is empty.
DATABASE_URL="postgresql://postgres:password@localhost:5432/lemonstand_landing"

# Outbound mail (SMTP, e.g. Zoho: smtppro.zoho.com:465). Leave unset in dev to skip sends.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Lemonstand <hello@lemonstand.ai>"
MAIL_REPLY_TO="hello@lemonstand.ai"
# Inbox(es) that get an alert for every signup and contact message
LEAD_ALERT_EMAIL="hello@lemonstand.ai"
SITE_URL="https://lemonstand.ai"
