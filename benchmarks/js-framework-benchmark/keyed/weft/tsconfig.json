  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@weft-js/core",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@weft-js/core/client"]
  },
  "include": ["src"]
}
