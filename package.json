{
  "name": "weft-repo",
  "private": true,
  "type": "module",
  "description": "Scripts for working on weft itself. Nothing here is published: the packages are in packages/.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/check.mjs",
    "fix": "node scripts/fix.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "check:prove": "node scripts/quality/prove.mjs",
    "proof:intel": "node scripts/intel/proof.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
