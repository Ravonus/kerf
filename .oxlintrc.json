{
  // The framework's own lint rules. `npm run check` runs them; `weft check` is what apps get, and that's a different thing.
  // Each rule here is on for a reason: a bug it catches, or one way of writing a thing. CONTRIBUTING.md has the short version.
  "jsPlugins": ["./scripts/quality/lint-plugin.mjs"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest", "promise", "node"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "ignorePatterns": [
    "**/node_modules/**", "**/dist/**", "**/.weft/**", "**/.output/**", "**/target/**",
    "**/fixture/**", "**/fixtures/**", "**/vendor/**", "**/gallery/assets/**",
    "packages/warp-icons/src/gen/**", "packages/warp-icons/art/**", "packages/text/gen/**", "packages/core/node/*.mjs", "packages/core/node/css/**/*.mjs", "packages/core/node/matrix/**/*.mjs", "packages/core/native/**",
    "packages/core/bench/corpus/**", "packages/warp-core/scripts/contrast-check.mjs", "packages/core/test/corpus-gen/**", "packages/db/test/generated/**",
    "docs/**", "spikes/**", "evals/*/**", "!evals/gates/**", "!evals/lib/**", "site/public/**", "site/content/**", "site/review/**"
  ],
  "env": { "browser": true, "node": true, "es2024": true, "vitest": true },
  "globals": { "Bun": "readonly", "Deno": "readonly" },
  "rules": {
    // Length findings are checked against scripts/quality/length-baseline.json by scripts/check.mjs.
    "max-lines": ["error", { "max": 400, "skipBlankLines": false }],
    "max-lines-per-function": ["error", { "max": 80, "skipBlankLines": false, "IIFEs": true }],
    // Bugs: dead code, wrong comparisons, names that hide each other.
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "no-shadow": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }], // `x == null` is how this repo says null or undefined
    "no-fallthrough": "error",
    "no-self-compare": "error",
    "no-case-declarations": "error",
    "no-redeclare": "error",
    "no-unreachable-loop": "error",
    "no-useless-assignment": "error",
    "array-callback-return": "error",
    "no-promise-executor-return": "error",
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true, "allowTaggedTemplates": true }],
    "no-use-before-define": ["error", { "functions": false, "classes": false, "variables": false }],

    // Async mistakes. These read the types, so they need a tsconfig: `oxlint --type-aware`.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/only-throw-error": "error",
    "promise/no-multiple-resolved": "error",

    // Types.
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": ["error", { "ts-ignore": true, "ts-nocheck": true, "ts-check": false, "ts-expect-error": "allow-with-description", "minimumDescriptionLength": 8 }],
    "typescript/prefer-ts-expect-error": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",

    // Consistency: one way of writing each of these.
    "no-var": "error",
    "prefer-const": "error",
    "object-shorthand": "error",
    "no-useless-return": "error",
    "no-useless-computed-key": "error",
    "no-lonely-if": "error",
    "prefer-object-has-own": "error",
    "no-prototype-builtins": "error",
    "no-template-curly-in-string": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/first": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",

    // Security: no code from strings, no unescaped markup.
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "typescript/no-implied-eval": "error",
    "weft/no-html-sink": "error",

    // Comments.
    "weft/no-commented-code": "error",
    "weft/todo-needs-issue": "error",
    "weft/disable-needs-reason": "error",
    "weft/public-doc": "error",
    "unicorn/no-abusive-eslint-disable": "error",

    // Tests.
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "off", // weft/skip-needs-reason asks for the reason instead of banning the skip
    "weft/skip-needs-reason": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-commented-out-tests": "error",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }], // expect(value, message) is vitest's own form
    "vitest/valid-describe-callback": "error",

    // On by category, off here because they are wrong for this repo.
    "no-underscore-dangle": "off", // internal fields are written `_x`
    "no-new": "off", // `new Worker(...)` and friends
    "import/no-unassigned-import": "off", // CSS
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "unicorn/consistent-function-scoping": "off", // a closure stays by the code it serves
    "unicorn/no-array-sort": "off", // sorting a fresh array in place is fine and faster
    "unicorn/no-array-reverse": "off",
    "unicorn/no-useless-spread": "off", // `[...set]` is often a snapshot taken on purpose, and its autofix breaks those
    "unicorn/no-unnecessary-await": "off", // `await 0` is a microtask turn; typescript/await-thenable covers the real mistake
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off", // only workers and MessagePorts here, which take no origin
    "promise/always-return": "off",
    "promise/no-promise-in-callback": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unsafe-enum-comparison": "off",
    "typescript/consistent-return": "off", // tsconfig's noImplicitReturns covers this
    "vitest/valid-title": "off",
    "vitest/expect-expect": "off", // gates assert through helpers
    "vitest/no-conditional-expect": "off",
    "vitest/no-conditional-tests": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/prefer-snapshot-hint": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/tests/**", "**/__tests__/**", "**/*.test.*", "**/*.spec.*", "**/*-test.*", "**/*_test.*", "**/*-spec.*", "**/*_spec.*", "**/test-*.*", "**/test_*.*", "**/*.generated.*", "**/*.gen.*", "**/*-generated.*", "**/*_generated.*", "**/*-gen.*", "**/*_gen.*", "**/generated/**", "**/gen/**", "**/vendor/**", "**/vendored/**", "**/fixtures/**", "**/fixture/**"],
      "rules": { "max-lines": ["error", { "max": 800, "skipBlankLines": false }] }
    },
    {
      // tsc doesn't read .mjs files, so this is what catches a dropped import there.
      "files": ["**/*.mjs", "**/*.cjs"],
      "rules": { "no-undef": "error" }
    },
    {
      // Code here runs inside the page, where the demo defines these.
      "files": ["packages/plugin-surface-keel/test/e2e.mjs"],
      "globals": { "lab": "readonly", "hashOf": "readonly", "clock": "readonly", "keelScene": "readonly" }
    },
    {
      // Code here runs inside the page, where the bundled warp-core dither entry is the global `dither`.
      "files": ["packages/warp/test/dither-*.browser.test.ts"],
      "globals": { "dither": "readonly" }
    },
    {
      // An art piece shows its own source: `./x.tsx?raw` is the file's text, not the module, so it is neither a cycle nor a self-import.
      "files": ["site/src/toolkit/art/*.tsx"],
      "rules": { "import/no-self-import": "off", "import/no-cycle": "off" }
    },
    {
      // warp-core is framework-agnostic: the framework is only ever reached from bindings/.
      "files": ["packages/warp-core/src/**"],
      "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@weft-js/*", "react", "react-dom", "react/*", "solid-js", "solid-js/*", "vue", "svelte", "svelte/*", "preact", "preact/*"], "message": "warp-core must not import a framework. Put this in bindings/." }] }] }
    },
    {
      // Core runs in the browser. The Node side of it is named below and in scripts/quality/boundaries.mjs.
      "files": ["packages/core/src/**"],
      "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["node:*", "fs", "path", "os", "crypto", "child_process", "url", "module"], "message": "Core must not import Node: it ships to browsers." }] }] }
    },
    {
      "files": ["packages/core/src/style/matrix.ts", "packages/core/src/test.ts", "packages/core/src/plugin.mjs", "packages/core/src/config.mjs"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // The entry and dom.ts are the public doors over modules that build on them. The cycle is the design, and order is tested.
      "files": ["packages/core/src/**"],
      "rules": { "import/no-cycle": "off" }
    },
    {
      // Tests set up the DOM with markup of their own, and may look like anything.
      "files": ["**/test/**", "**/*.test.*", "**/scripts/**", "scripts/**", "evals/**"],
      "rules": { "weft/no-html-sink": "off" }
    }
  ]
}
