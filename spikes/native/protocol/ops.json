{
  "$comment": "Single source of the JS -> host op protocol. Run `node scripts/gen-protocol.mjs` after editing; it writes the TS, Swift and Rust constants.",
  "version": 1,
  "ops": {
    "CREATE": {
      "code": 1,
      "args": [
        "id",
        "type"
      ]
    },
    "REMOVE": {
      "code": 2,
      "args": [
        "id"
      ],
      "doc": "Detach and destroy the node and its subtree"
    },
    "INSERT": {
      "code": 3,
      "args": [
        "parent",
        "id",
        "before"
      ],
      "doc": "before = 0 appends"
    },
    "SET_STR": {
      "code": 4,
      "args": [
        "id",
        "prop",
        "byteLength"
      ],
      "doc": "Followed by UTF-8 bytes, zero-padded to 4"
    },
    "SET_NUM": {
      "code": 5,
      "args": [
        "id",
        "prop"
      ],
      "doc": "Followed by one float64 (two words)"
    },
    "SET_BOOL": {
      "code": 6,
      "args": [
        "id",
        "prop",
        "value"
      ]
    },
    "LISTEN": {
      "code": 7,
      "args": [
        "id",
        "event"
      ]
    },
    "ROOT": {
      "code": 8,
      "args": [
        "id"
      ]
    }
  },
  "types": {
    "Stack": 1,
    "Row": 2,
    "Text": 3,
    "Button": 4,
    "Input": 5,
    "Scroll": 6,
    "Choice": 7
  },
  "props": {
    "text": 1,
    "gap": 2,
    "pad": 3,
    "align": 4,
    "justify": 5,
    "grow": 6,
    "label": 7,
    "disabled": 8,
    "value": 9,
    "placeholder": 10,
    "role": 11,
    "tone": 12,
    "options": 13,
    "selected": 14,
    "surface": 15
  },
  "events": {
    "tap": 1,
    "input": 2,
    "select": 3
  },
  "layoutKeys": {
    "direction": 1,
    "gap": 2,
    "pad": 3,
    "grow": 4,
    "align": 5,
    "justify": 6,
    "width": 7,
    "height": 8,
    "minHeight": 9,
    "scroll": 10
  },
  "align": {
    "start": 0,
    "center": 1,
    "end": 2,
    "stretch": 3,
    "between": 4
  },
  "space": {
    "none": 0,
    "tight": 4,
    "related": 8,
    "group": 16,
    "section": 32
  },
  "text": {
    "title": {
      "size": 22,
      "weight": 600
    },
    "body": {
      "size": 17,
      "weight": 400
    },
    "caption": {
      "size": 13,
      "weight": 500
    }
  },
  "controls": {
    "minHeight": 44,
    "buttonPadX": 16
  }
}
