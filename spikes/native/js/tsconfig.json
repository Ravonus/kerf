{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "../protocol/idioms.json"
  ],
  "exclude": [
    "src/app.source.tsx"
  ]
}
