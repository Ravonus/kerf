{
  "name": "weft-og-spike-takumi",
  "main": "takumi.mjs",
  "compatibility_date": "2026-10-01",
  "minify": true,
  "rules": [
    { "type": "Data", "globs": ["**/*.woff", "**/*.woff2", "**/*.jpg"], "fallthrough": false },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ]
}
