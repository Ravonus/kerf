{
  "name": "weft-og-spike",
  "private": true,
  "type": "module",
  "description": "Research 20 §7.3: Takumi vs Satori + resvg for OG cards rendered from weft SSR HTML. Not part of the weft package.",
  "scripts": {
    "build:cards": "node build-cards.mjs",
    "bench": "node bench.mjs",
    "measure": "node run-all.mjs 5 100",
    "worker:takumi": "wrangler dev -c worker/wrangler.takumi.jsonc",
    "worker:satori": "wrangler dev -c worker/wrangler.satori.jsonc",
    "test": "node --test card/card.test.mjs",
    "bench:card": "node card/bench.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@resvg/resvg-wasm": "2.6.2",
    "@takumi-rs/core": "2.16.2",
    "@takumi-rs/helpers": "2.16.2",
    "@takumi-rs/wasm": "2.16.2",
    "@vercel/og": "1.0.3",
    "satori": "0.57.2",
    "satori-032": "npm:satori@0.32.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.150.0"
  }
}
