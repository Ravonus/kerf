#!/bin/sh
# Optional and quick: only what's staged, only the checks that take seconds. Turn it on with `npm run hooks`, off with
# `git config --unset core.hooksPath`. CI still runs all of it.
set -e
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

scripts=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|mts|cts|mjs|cjs|js)$' | grep -E '^(packages|scripts|site)/' || true)
if [ -n "$scripts" ]; then
  # shellcheck disable=SC2086
  node_modules/.bin/oxlint --quiet --deny-warnings $scripts
fi
if printf '%s\n' "$staged" | grep -qE '^crates/.*\.rs$'; then
  for crate in crates/weft-compiler crates/weft-layout crates/weft; do (cd "$crate" && cargo fmt --check); done
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --config .gitleaks.toml --redact --no-banner --log-level error
fi
