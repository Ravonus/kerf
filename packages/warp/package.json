{
  "name": "@weft-js/warp",
  "version": "0.1.1",
  "description": "warp, the UI toolkit for weft: components over @weft-js/warp-core",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/styles.ts",
    "./src/fields.ts",
    "./src/ui.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./skeleton": "./src/skeleton-css.ts",
    "./ui": "./src/ui.ts",
    "./plugin": "./plugin.mjs",
    "./tailwind.css": "./tailwind.css"
  },
  "scripts": {
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "a11y": "node scripts/a11y.mjs",
    "virtual": "node scripts/virtual.mjs",
    "dither": "node scripts/dither.mjs"
  },
  "dependencies": {
    "@weft-js/warp-icons": "file:../icons",
    "@weft-js/warp-core": "file:../warp-core"
  },
  "peerDependencies": {
    "@weft-js/core": "*"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "axe-core": "^4.14.0",
    "jsdom": "30.1.3",
    "playwright-core": "^1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@weft-js/core": "file:../weft"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "weft"
  ],
  "files": [
    "src",
    "plugin.mjs",
    "plugin.d.mts",
    "tailwind.css",
    "tokens",
    "README.md",
    "LICENSE"
  ]
}
