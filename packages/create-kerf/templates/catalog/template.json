{
  "requires": { "db": "postgres", "auth": false },
  "pages": ["/", "/c/[slug]", "/p/[slug]", "/cart"],
  "veneer": {
    "seed": { "accent": "#8a2435" },
    "dials": { "expression": "balanced", "density": "comfortable" },
    "radius": "round",
    "fields": "classic",
    "fonts": {
      "display": "\"Avenir Next\", \"Century Gothic\", Futura, ui-sans-serif, system-ui, sans-serif",
      "body": "\"Avenir Next\", \"Segoe UI\", ui-sans-serif, system-ui, sans-serif"
    },
    "tokens": {
      "--veneer-color-page": "light-dark(#f7f6f3, #141213)",
      "--veneer-color-surface": "light-dark(#fdfcfa, #1d1a1b)",
      "--veneer-color-surface-raised": "light-dark(#ffffff, #231f20)",
      "--veneer-color-surface-sunken": "light-dark(#f1efea, #0e0c0d)"
    }
  }
}
