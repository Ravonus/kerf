{
  "name": "@weft-js/warp-core",
  "version": "0.1.4",
  "description": "warp core: tokens, CSS and framework-agnostic behaviour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravonus/weft.git",
    "directory": "packages/warp-core"
  },
  "homepage": "https://github.com/Ravonus/weft/tree/main/packages/warp-core#readme",
  "bugs": {
    "url": "https://github.com/Ravonus/weft/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "styles",
    "bindings",
    "scripts/contrast-check.mjs",
    "scripts/contrast-check-colors.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./weft": "./bindings/weft.ts",
    "./motion": "./src/motion.ts",
    "./charts": "./src/charts/index.ts",
    "./canvas": "./src/canvas.ts",
    "./stage": "./src/stage.ts",
    "./dither": "./src/dither/index.ts",
    "./search": "./src/search.ts",
    "./styles/*": "./styles/*"
  },
  "peerDependencies": {
    "@weft-js/core": "*"
  },
  "peerDependenciesMeta": {
    "@weft-js/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "vitest": "5.0.5",
    "@weft-js/core": "workspace:*"
  },
  "scripts": {
    "build:css": "node scripts/split-css.mjs",
    "test": "node scripts/split-css.mjs --check && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "weft"
  ]
}
