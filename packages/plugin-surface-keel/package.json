{
  "name": "@weft-js/plugin-surface-keel",
  "version": "0.1.1",
  "description": "@weft-js/plugin-surface-keel: the `keel-pixel` surface kind (surface.renderer@1): KEEL's WebGL2 pixel renderer and theme recipes.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./runtime": "./src/runtime.mjs",
    "./theme": {
      "types": "./src/index.d.ts",
      "default": "./src/theme.mjs"
    },
    "./styles.css": "./vendor/keel-styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs chrome && node test/e2e.mjs webkit",
    "vendor": "node scripts/vendor.mjs"
  },
  "peerDependencies": {
    "@weft-js/core": "*"
  },
  "devDependencies": {
    "@weft-js/text": "workspace:*",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@weft-js/core": "workspace:*"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "weft"
  ],
  "files": [
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
