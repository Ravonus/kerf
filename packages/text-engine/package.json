{
  "name": "@weft/text-engine",
  "version": "0.0.1",
  "private": true,
  "description": "Slim, per-engine, lazily split build of Pretext (@chenglou/pretext 1.0.0, MIT, by Cheng Lou) behind weft's measure provider",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./gen/*/pack-*.ts",
    "./dist/**",
    "./test/**"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "gen": "node scripts/specialize.mjs",
    "coverage": "node scripts/specialize.mjs --no-rare && node scripts/coverage.mjs && node scripts/specialize.mjs",
    "build": "node scripts/specialize.mjs && node scripts/build.mjs --minifier terser",
    "size": "node scripts/build.mjs --minifier terser --json dist/size.json",
    "test": "node scripts/specialize.mjs && vitest run",
    "test:accuracy": "node test/accuracy/run.mjs chrome && node test/accuracy/run.mjs webkit",
    "typecheck": "node scripts/specialize.mjs && node scripts/typecheck.mjs"
  },
  "pretext": {
    "version": "1.0.0",
    "tarball": "https://registry.npmjs.org/@chenglou/pretext/-/pretext-1.0.0.tgz",
    "sha256": "f1d9ac427846d40d3500854f4ff935272abe657d898e70ec75077065633c060a",
    "integrity": "sha512-BxKiDMxWJhyzL8asvcgg3T9YnUU7OUFsKO8oRaR2SYAPX4Sh2wM9gqTBjrBaZ4fnl84cEQ8czC0Q1M83z3chsA=="
  },
  "devDependencies": {
    "@chenglou/pretext": "1.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
