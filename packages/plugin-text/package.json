{
  "name": "@weft/plugin-text",
  "version": "0.0.0",
  "private": true,
  "description": "@weft/plugin-text: the font build step (font.build@1) and text measuring (text.measure@1, slim engine or pinned Pretext).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./build": "./src/build.mjs",
    "./measure": "./src/measure.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:conformance": "npm run build --prefix ../text-engine && node test/conformance.mjs chrome && node test/conformance.mjs webkit"
  },
  "dependencies": {
    "@capsizecss/metrics": "4.4.0",
    "@capsizecss/unpack": "4.0.1",
    "@chenglou/pretext": "1.0.0",
    "@weft/text-engine": "file:../text-engine",
    "fontverter": "2.0.0",
    "subset-font": "2.9.0"
  },
  "peerDependencies": {
    "weft": "*"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "vitest": "5.0.5",
    "weft": "file:../weft"
  }
}
