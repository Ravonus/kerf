{
  "name": "@kerf/core",
  "version": "0.1.0",
  "description": "kerf: a fine-grained reactive TSX framework. Runtime, compiler binding, Vite plugin and test utilities.",
  "keywords": [
    "kerf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravonus/kerf.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ravonus/kerf/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Ravonus/kerf/issues"
  },
  "files": [
    "src",
    "node",
    "native/kerf-compiler.wasm",
    "scripts/native-stamp.cjs",
    "assets.mjs",
    "client.d.ts",
    "compiler.cjs",
    "compiler-wasm.cjs",
    "media-probe.mjs",
    "platforms.cjs",
    "vite.mjs",
    "vite",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./src/full.ts",
    "./src/keyed.ts",
    "./src/persist.ts",
    "./src/history.ts",
    "./src/sync.ts"
  ],
  "exports": {
    ".": "./src/full.ts",
    "./internal": "./src/internal.ts",
    "./keyed": "./src/keyed.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./dom": "./src/dom.ts",
    "./ssr": "./src/ssr.ts",
    "./head": "./src/head-client.ts",
    "./test": "./src/test.ts",
    "./test/plugins": "./src/test-plugins.ts",
    "./persist": "./src/persist.ts",
    "./history": "./src/history.ts",
    "./sync": "./src/sync.ts",
    "./interaction": "./src/interaction.ts",
    "./browser": "./src/browser.ts",
    "./style": "./src/style.ts",
    "./ds": "./src/ds.ts",
    "./media": "./src/media.tsx",
    "./shape": "./src/shape.ts",
    "./text": "./src/text.tsx",
    "./surface": "./src/surface.tsx",
    "./media-probe": "./media-probe.mjs",
    "./client": {
      "types": "./client.d.ts"
    },
    "./style/matrix": "./node/matrix.mjs",
    "./hydration": "./node/hydration.mjs",
    "./markup": {
      "types": "./src/markup-shared.d.mts",
      "default": "./src/markup-shared.mjs"
    },
    "./node-purge": "./node/purge.mjs",
    "./hmr": "./src/hmr.ts",
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./devtools": "./src/devtools.ts",
    "./agent": "./src/agent.ts",
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    },
    "./vite": "./vite.mjs",
    "./compiler": "./compiler.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:platform": "node scripts/build-platform.mjs",
    "prepack": "node scripts/build-wasm.mjs --if-stale && node scripts/copy-docs.mjs",
    "parity": "node scripts/parity.mjs",
    "test": "node --no-warnings scripts/node-style.mjs --check && vitest run",
    "bench": "node scripts/bench.mjs",
    "size": "node scripts/size.mjs",
    "test:shapes": "node --test test/e2e/*.e2e.mjs"
  },
  "dependencies": {
    "dom-accessibility-api": "0.7.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=10",
    "@testing-library/user-event": ">=14",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@kerf/compiler-darwin-arm64": "0.1.0",
    "@kerf/compiler-darwin-x64": "0.1.0",
    "@kerf/compiler-linux-arm64-gnu": "0.1.0",
    "@kerf/compiler-linux-arm64-musl": "0.1.0",
    "@kerf/compiler-linux-x64-gnu": "0.1.0",
    "@kerf/compiler-linux-x64-musl": "0.1.0",
    "@kerf/compiler-win32-arm64": "0.1.0",
    "@kerf/compiler-win32-x64": "0.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
