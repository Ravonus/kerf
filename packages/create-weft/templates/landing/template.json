{
  "requires": { "db": "postgres", "auth": false },
  "pages": ["/", "/pricing", "/privacy", "/joined"],
  "dependencies": { "@weft/icons": "0.0.0", "@weft/plugin-media": "0.0.0", "@weft/plugin-text": "0.0.0" },
  "warp": {
    "seed": { "accent": "#c2410c" },
    "dials": { "expression": "vivid" },
    "radius": "round",
    "fonts": { "display": "\"Figtree\", \"Figtree Fallback\", ui-sans-serif, system-ui, sans-serif", "body": "\"Figtree\", \"Figtree Fallback\", ui-sans-serif, system-ui, sans-serif" },
    "tokens": {
      "--warp-color-page": "light-dark(#f8f1e4, #1d1613)",
      "--warp-color-surface": "light-dark(#fdf8ee, #261d19)",
      "--warp-color-surface-raised": "light-dark(#fffcf5, #281e1a)",
      "--warp-color-surface-sunken": "light-dark(#f5eee0, #171110)"
    }
  }
}
