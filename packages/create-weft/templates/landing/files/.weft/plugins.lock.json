{
  "version": 1,
  "plugins": {
    "@weft-js/plugin-media": {
      "version": null,
      "integrity": null,
      "permissions": [
        "env:WEFT_MEDIA_DIR",
        "fs.read:**/*.{png,jpg,jpeg,gif,webp,avif,svg,mp4,m4v,mov,webm,mkv,ogv,mp3,wav,flac,ogg,oga,opus,m4a,aac}",
        "native",
        "spawn:ssimulacra2"
      ],
      "provides": [
        "media.build",
        "media.server"
      ],
      "undeclared": []
    },
    "@weft-js/text": {
      "version": null,
      "integrity": null,
      "permissions": [
        "fs.read:**/*.{woff2,woff,ttf,otf}"
      ],
      "provides": [
        "font.build"
      ],
      "undeclared": []
    },
    "@weft-js/warp": {
      "version": null,
      "integrity": null,
      "permissions": [
        "fs.read:node_modules/@weft-js/warp-core/**",
        "fs.write:$TMPDIR/warp-seed-*",
        "spawn:node"
      ],
      "provides": [],
      "undeclared": []
    }
  }
}
