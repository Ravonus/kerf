{
  "name": "@weft-js/warp-icons",
  "version": "0.1.0",
  "description": "Icons for warp and weft",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/gen/index.tsx",
    "./all": "./src/all.tsx",
    "./quiet": "./src/gen/all.tsx",
    "./balanced": "./src/gen/all.tsx",
    "./vivid": "./src/gen/all.tsx",
    "./names": "./src/names.tsx",
    "./icon": "./src/icon.tsx",
    "./late": "./src/late.tsx",
    "./compile": "./compile.mjs",
    "./plugin": "./plugin.mjs",
    "./icons.css": "./src/icons.css",
    "./tiers.css": "./src/tiers.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sheet": "node scripts/sheet.mjs",
    "test": "node scripts/build.mjs --check && vitest run"
  },
  "peerDependencies": {
    "vite": "*",
    "@weft-js/core": "*"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@weft-js/core": "file:../weft"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "weft"
  ],
  "files": [
    "src",
    "plugin.mjs",
    "compile.mjs",
    "README.md",
    "LICENSE"
  ]
}
