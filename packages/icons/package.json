{
  "name": "@weft/icons",
  "version": "0.0.0",
  "private": true,
  "description": "weft's own icon set: original SVG in warp's three expression tiers, outline at quiet and balanced, drawn pixel art at vivid",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/gen/all.tsx",
    "./all": "./src/all.tsx",
    "./quiet": "./src/gen/all.tsx",
    "./balanced": "./src/gen/all.tsx",
    "./vivid": "./src/gen/all.tsx",
    "./names": "./src/names.tsx",
    "./icon": "./src/icon.tsx",
    "./late": "./src/late.tsx",
    "./compile": "./compile.mjs",
    "./plugin": "./plugin.mjs",
    "./icons.css": "./src/icons.css",
    "./tiers.css": "./src/tiers.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sheet": "node scripts/sheet.mjs",
    "test": "node scripts/build.mjs --check && vitest run"
  },
  "peerDependencies": {
    "vite": "*",
    "weft": "*"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "weft": "file:../weft"
  }
}
