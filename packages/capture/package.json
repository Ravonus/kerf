{
  "name": "@kerf-js/capture",
  "version": "0.1.0",
  "description": "@kerf-js/capture: drive a built kerf page in headless Chrome on the GPU for repeatable stills at scroll stops, frame-time runs and contact sheets, and bake scene posters at build time. Dev only.",
  "keywords": [
    "capture",
    "screenshot",
    "poster",
    "kerf"
  ],
  "homepage": "https://github.com/Ravonus/kerf/tree/main/packages/capture#readme",
  "bugs": {
    "url": "https://github.com/Ravonus/kerf/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravonus/kerf.git",
    "directory": "packages/capture"
  },
  "type": "module",
  "bin": {
    "kerf-capture": "./bin/kerf-capture.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./cli": "./src/cli.mjs",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.mjs"
    },
    "./posters": {
      "types": "./src/posters.d.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@kerf-js/media": "workspace:*",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@kerf-js/veneer": "*"
  },
  "peerDependenciesMeta": {
    "@kerf-js/veneer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kerf-js/veneer": "workspace:*",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
