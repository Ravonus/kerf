{
  "name": "@weft-js/plugin-keel",
  "version": "0.1.4",
  "description": "@weft-js/plugin-keel: KEEL generation for weft. The `keel-lit` surface kind (surface.renderer@1) and KEEL's generative modules: trees, looks, light.",
  "keywords": [
    "weft"
  ],
  "homepage": "https://github.com/Ravonus/weft/tree/main/packages/plugin-keel#readme",
  "bugs": {
    "url": "https://github.com/Ravonus/weft/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravonus/weft.git",
    "directory": "packages/plugin-keel"
  },
  "files": [
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./runtime": "./src/runtime.ts",
    "./stage": "./src/stage.ts",
    "./scene": "./src/scene.ts",
    "./governor": "./src/governor.ts",
    "./lit": {
      "types": "./vendor/lit.d.mts",
      "default": "./vendor/lit.mjs"
    },
    "./modules/*": {
      "types": "./vendor/modules/*.d.mts",
      "default": "./vendor/modules/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@weft-js/core": "workspace:*",
    "@weft-js/scroll": "workspace:*",
    "@weft-js/warp": "workspace:*",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@weft-js/core": "*"
  },
  "engines": {
    "node": ">=24"
  }
}
