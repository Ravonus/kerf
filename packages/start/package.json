{
  "name": "@weft-js/start",
  "version": "0.1.3",
  "description": "weft Start: file routes, server functions, streaming SSR, a database and auth",
  "keywords": [
    "weft"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravonus/weft.git",
    "directory": "packages/start"
  },
  "homepage": "https://github.com/Ravonus/weft/tree/main/packages/start#readme",
  "bugs": {
    "url": "https://github.com/Ravonus/weft/issues"
  },
  "files": [
    "src",
    "crate",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/share.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/data.ts",
    "./derive": "./src/derive.mjs",
    "./media": "./src/media.ts",
    "./hub": "./src/hub.ts",
    "./live": "./src/stream.ts",
    "./bus": "./src/bus.ts",
    "./changes": "./src/changes.ts",
    "./changes-sql": "./src/changes-sql.mjs",
    "./live-target": "./src/live-target.mjs",
    "./listen": "./src/listen.ts",
    "./verify": "./src/verify.ts",
    "./bus/postgres": "./src/bus/postgres.ts",
    "./list": "./src/list.ts",
    "./list/drizzle": "./src/list-drizzle.ts",
    "./channel": "./src/channel.ts",
    "./share": "./src/share.ts",
    "./db": "./src/db/index.ts",
    "./db/core": "./src/db/core.ts",
    "./db/sqlite": "./src/db/sqlite.ts",
    "./db/postgres": "./src/db/postgres.ts",
    "./db/mysql": "./src/db/mysql.ts",
    "./auth": "./src/auth.ts",
    "./auth/better-auth": "./src/auth/better-auth.ts",
    "./auth/drizzle": "./src/auth/drizzle.ts",
    "./extension": "./src/extension.ts",
    "./client": "./src/client.tsx",
    "./server": "./src/server.tsx",
    "./vite": "./src/vite.mjs",
    "./routes": "./src/routes.mjs",
    "./og": "./src/og/index.mjs",
    "./app": "./src/app.mjs",
    "./inspect": "./src/inspect.mjs",
    "./contract": "./src/contract.mjs",
    "./rust": "./src/rust.ts",
    "./sidecar": "./src/sidecar.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node scripts/runtime-matrix.mjs",
    "prepack": "node scripts/crate.mjs",
    "postpack": "node scripts/crate.mjs --clean",
    "test:shapes": "node --test test/e2e/*.e2e.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@takumi-rs/core": "2.18.2",
    "@takumi-rs/helpers": "2.18.2",
    "@takumi-rs/wasm": "2.18.2",
    "@tanstack/history": "1.162.5",
    "@tanstack/router-core": "1.171.39",
    "nitro": "3.0.260903-beta",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@weft-js/core": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "jose": "6.2.14",
    "jsdom": "30.1.3",
    "mysql2": "3.24.6",
    "playwright-core": "1.64.1",
    "postgres": "4.0.0",
    "sharp": "^0.35.5",
    "svgo": "4.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@weft-js/core": "*",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.8.0",
    "mysql2": "^3.24.0",
    "postgres": ">=3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "drizzle-zod": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@nats-io/transport-node": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
