{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["es2023", "dom"],
    "types": [],
    "paths": { "@engine/*": ["./gen/blink/*"] },
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts"]
}
