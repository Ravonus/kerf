{
  "name": "weft",
  "version": "0.0.0",
  "private": true,
  "description": "weft runtime, compiler binding, Vite plugin and test utilities (Phase 1 compiler spike)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/persist.ts",
    "./src/history.ts",
    "./src/sync.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./dom": "./src/dom.ts",
    "./ssr": "./src/ssr.ts",
    "./head": "./src/head-client.ts",
    "./test": "./src/test.ts",
    "./test/plugins": "./src/test-plugins.ts",
    "./persist": "./src/persist.ts",
    "./history": "./src/history.ts",
    "./sync": "./src/sync.ts",
    "./browser": "./src/browser.ts",
    "./style": "./src/style.ts",
    "./ds": "./src/ds.ts",
    "./media": "./src/media.tsx",
    "./shape": "./src/shape.ts",
    "./text": "./src/text.tsx",
    "./pay": "./src/pay.ts",
    "./pay/server": "./src/pay-server.ts",
    "./surface": "./src/surface.tsx",
    "./media-probe": "./media-probe.mjs",
    "./client": {
      "types": "./client.d.ts"
    },
    "./style/matrix": "./node/matrix.mjs",
    "./hydration": "./node/hydration.mjs",
    "./hmr": "./src/hmr.ts",
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./devtools": "./src/devtools.ts",
    "./agent": "./src/agent.ts",
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    },
    "./vite": "./vite.mjs",
    "./compiler": "./compiler.cjs"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test": "node --no-warnings scripts/node-style.mjs --check && vitest run",
    "bench": "node scripts/bench.mjs",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=10",
    "@testing-library/user-event": ">=14",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "dom-accessibility-api": "0.7.1"
  }
}
