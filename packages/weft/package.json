{
  "name": "weft",
  "version": "0.0.0",
  "private": true,
  "description": "weft runtime, compiler binding, Vite plugin and test utilities (Phase 1 compiler spike)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/persist.ts",
    "./src/history.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./dom": "./src/dom.ts",
    "./ssr": "./src/ssr.ts",
    "./head": "./src/head-client.ts",
    "./test": "./src/test.ts",
    "./persist": "./src/persist.ts",
    "./history": "./src/history.ts",
    "./browser": "./src/browser.ts",
    "./style": "./src/style.ts",
    "./media": "./src/media.tsx",
    "./media-probe": "./media-probe.mjs",
    "./client": { "types": "./client.d.ts" },
    "./style/matrix": "./src/style/matrix.ts",
    "./hmr": "./src/hmr.ts",
    "./plugin": { "types": "./src/plugin.d.ts", "default": "./src/plugin.mjs" },
    "./devtools": "./src/devtools.ts",
    "./agent": "./src/agent.ts",
    "./vite": "./vite.mjs",
    "./compiler": "./compiler.cjs"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=10",
    "@testing-library/user-event": ">=14",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "dom-accessibility-api": "0.5.16"
  }
}
